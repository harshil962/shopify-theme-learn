<section class="custom-content {% if section.settings.full_width %}full-width{% else %}page-width{% endif %}">
  <div class="custom-content__inner{% if section.settings.image == blank %} custom-content__inner--text-only{% endif %}">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 900
        | image_tag: class: 'custom-content__image', alt: section.settings.image.alt, loading: 'lazy'
      }}
    {% endif %}

    <div class="custom-content__body">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when 'heading' %}
              <h2>{{ block.settings.text | escape }}</h2>

            {% when 'text' %}
              <p>{{ block.settings.text | escape | newline_to_br }}</p>
          {% endcase %}
        </div>
      {% endfor %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text | escape | newline_to_br }}</p>
      {% endif %}
      {% if section.settings.button_lable != blank %}
        <a class="custom-content__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_lable | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .custom-content {
    padding-block: clamp(2rem, 6vw, 5rem);
    background: #f8fafc;
  }

  .custom-content__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    max-width: 72rem;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-inline: auto;
    padding: clamp(1.25rem, 4vw, 3rem);
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: 0 12px 32px rgb(15 23 42 / 7%);
  }

  .custom-content__image {
    width: 100%;
    height: 100%;
    min-height: 18rem;
    max-height: 32rem;
    border-radius: 0.875rem;
    background: #f1f5f9;
    object-fit: cover;
  }

  .custom-content__body {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .custom-content__body h2 {
    color: #172554;
    font-family: var(--heading-font);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .custom-content__body p {
    color: #475569;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
  }

  .custom-content__button {
    display: inline-flex;
    min-height: 2.875rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border: 1px solid #1d4ed8;
    border-radius: 999px;
    background: #1d4ed8;
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .custom-content__button:hover {
    transform: translateY(-2px);
    border-color: #172554;
    background: #172554;
  }

  .custom-content__inner--text-only {
    grid-template-columns: minmax(0, 1fr);
  }

  .custom-content__inner--text-only .custom-content__body {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  .custom-content.full-width {
    width: 100%;
    max-width: none;
  }

  @media screen and (max-width: 749px) {
    .custom-content__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .custom-content__image {
      min-height: 0;
      max-height: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-content__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Custom Content",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "welcome to our store"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover our letest products."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Select Image"
    },
    {
      "type": "text",
      "id": "button_lable",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Enable full width",
      "default": false
    }
  ],

  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "New heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text content",
          "default": "write your content here !!"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom Content"
    }
  ]
}
{% endschema %}
