<div
  class="product-recommendations page-width"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related"
>
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    <h2>You may also like</h2>

    <div class="recommendation-grid">
      {% for recommended_product in recommendations.products %}
        <div class="recommendation-card">
          <a href="{{ recommended_product.url }}">
            {% if recommended_product.featured_image != blank %}
              {{ recommended_product.featured_image | image_url: width: 300 | image_tag: width: 300, loading: 'lazy' }}
            {% endif %}

            <h3>{{ recommended_product.title | escape }}</h3>
          </a>

          <p>{{ recommended_product.price | money }}</p>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  (() => {
    const section = document.querySelector('#shopify-section-{{ section.id }} .product-recommendations');

    if (!section || !section.dataset.url) return;

    fetch(section.dataset.url)
      .then((response) => response.text())
      .then((htmlText) => {
        const doc = new DOMParser().parseFromString(htmlText, 'text/html');
        const updatedSection = doc.querySelector('#shopify-section-{{ section.id }} .product-recommendations');

        if (updatedSection) {
          section.innerHTML = updatedSection.innerHTML;
        }
      })
      .catch((error) => console.error('Recommendations failed:', error));
  })();
</script>

{% style %}
  .product-recommendations {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .product-recommendations h2 {
    margin-bottom: 1.5rem;
    color: #172554;
    font-family: var(--heading-font);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .recommendation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: clamp(0.875rem, 2vw, 1.5rem);
  }

  .recommendation-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.875rem;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    background: linear-gradient(180deg, #fff 0%, #f8fafc 100%);
    box-shadow: 0 4px 14px rgb(15 23 42 / 6%);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .recommendation-card:hover,
  .recommendation-card:focus-within {
    transform: translateY(-3px);
    border-color: #bfdbfe;
    box-shadow: 0 12px 26px rgb(15 23 42 / 12%);
  }

  .recommendation-card > a {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    color: #0f172a;
  }

  .recommendation-card img {
    width: 20%;
    aspect-ratio: 1;
    border-radius: 0.75rem;
    background: #f1f5f9;
    object-fit: contain;
  }

  .recommendation-card h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .recommendation-card > p {
    margin-top: auto;
    color: #1d4ed8;
    font-size: 1.125rem;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .recommendation-card {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
